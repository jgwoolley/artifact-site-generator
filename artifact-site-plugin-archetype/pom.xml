<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nf3t</groupId>
    <artifactId>artifact-site-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>artifact-site-plugin-archetype</artifactId>
  <packaging>maven-archetype</packaging>
  <name>Artifact Site Plugin Archetype</name>
  <description>Maven archetype that scaffolds a new Artifact Site Generator parser plugin module.</description>
  <developers>
    <developer><name>jgwoolley</name></developer>
  </developers>
  <scm>
    <url>https://github.com/jgwoolley/artifact-site-generator</url>
    <connection>scm:git:git://github.com/jgwoolley/artifact-site-generator.git</connection>
    <developerConnection>scm:git:ssh://github.com/jgwoolley/artifact-site-generator.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <build>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <version>3.2.1</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-archetype-plugin</artifactId>
        <version>3.2.1</version>
      </plugin>
    </plugins>
  </build>
</project>
