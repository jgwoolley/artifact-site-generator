<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nf3t</groupId>
    <artifactId>artifact-site-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>artifact-site-plugin-maven</artifactId>
  <name>Artifact Site Maven Plugin</name>
  <description>Generates documentation for maven artifacts.</description>
  <developers>
    <developer><name>jgwoolley</name></developer>
  </developers>
  <scm>
    <url>https://github.com/jgwoolley/artifact-site-generator</url>
    <connection>scm:git:git://github.com/jgwoolley/artifact-site-generator.git</connection>
    <developerConnection>scm:git:ssh://github.com/jgwoolley/artifact-site-generator.git</developerConnection>
    <tag>HEAD</tag>
  </scm>
	<properties>
		<nifi.version>1.28.1</nifi.version>
	</properties>

  <dependencies>
    <dependency>
      <groupId>com.nf3t</groupId>
      <artifactId>artifact-site-plugins-api</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.pf4j</groupId>
      <artifactId>pf4j</artifactId>
      <version>${pf4j.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.26.3</version>
      <scope>test</scope>
    </dependency>
	<dependency>
	    <groupId>org.apache.maven</groupId>
	    <artifactId>maven-model</artifactId>
	    <version>3.9.9</version>
	</dependency>
	<dependency>
	    <groupId>org.apache.nifi</groupId>
	    <artifactId>nifi-extension-manifest-parser</artifactId>
	    <version>${nifi.version}</version>
	</dependency>
    <dependency>
      <groupId>com.sun.xml.bind</groupId>
      <artifactId>jaxb-impl</artifactId>
      <version>2.3.3</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.pf4j</groupId>
              <artifactId>pf4j</artifactId>
              <version>${pf4j.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <!-- Plugin jars are loaded by pf4j's JarPluginLoader as a single file, so this
           module's own (non-provided) dependencies must be shaded into that jar; the
           host CLI only forwards com.nf3t.artifactsite.api.* and org.pf4j.* classes to
           plugin classloaders (see ArtifactSiteGeneratorCli.ApiParentFirstPluginClassLoader),
           so maven-model / nifi-extension-manifest-parser must live inside this jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Plugin-Id>maven</Plugin-Id>
                    <Plugin-Version>${project.version}</Plugin-Version>
                    <Plugin-Provider>jgwoolley</Plugin-Provider>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
